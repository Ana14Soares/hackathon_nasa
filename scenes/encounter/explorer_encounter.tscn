[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/encounter/explorer_encounter.gd" id="1_enc"]
[ext_resource type="PackedScene" path="res://scenes/ship/ship_interior.tscn" id="2_ship"]
[ext_resource type="PackedScene" path="res://ui/overlays/scan_overlay.tscn" id="3_scan"]
