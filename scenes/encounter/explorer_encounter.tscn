[node name="ExplorerEncounter" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_enc")

[node name="ShipInterior" parent="." instance=ExtResource("2_ship")]
unique_name_in_owner = true
layout_mode = 1

[node name="FxLayer" type="CanvasLayer" parent="."]
layer = 5

[node name="ScanOverlay" parent="FxLayer" instance=ExtResource("3_scan")]
unique_name_in_owner = true

[node name="UiLayer" type="CanvasLayer" parent="."]
layer = 10

[node name="DialogueBox" parent="UiLayer" instance=ExtResource("4_dlg")]
unique_name_in_owner = true

[node name="RewardPopup" parent="UiLayer" instance=ExtResource("5_reward")]
unique_name_in_owner = true
close_on_click_outside = false

[node name="DiaryBook" parent="UiLayer" instance=ExtResource("6_diary")]
unique_name_in_owner = true

[node name="IdCardOverlay" parent="UiLayer" instance=ExtResource("7_card")]
